/*
!/.gitignore
!/.gitattributes
!/app/
!/README.md

# ---------- Dependencies ----------
node_modules/
scripts/node_modules/
.pnp.*

# ---------- Build output (regenerate with `npm run build`; the submission ZIP contains a prebuilt dist) ----------
# TIP: if the platform only accepts a GitHub link, run `git add -f app/dist` in the FINAL commit, or attach submission.zip to a GitHub Release.
dist/
build/
out/
.vite/
.next/
.cache/
.turbo/
coverage/
*.tsbuildinfo

# ---------- Secrets & env (NEVER commit) ----------
.env
.env.*
!.env.example

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---------- Test/audit artifacts ----------
playwright-report/
test-results/
docs/audit.json

# ---------- Packaging output ----------
submission.zip
submission/

# ---------- Local databases created while running the app ----------
*.sqlite
*.sqlite3
app/data/*.db

# ---------- OS / editor noise ----------
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
